<template>
  <div>
    <div class="modal-mask" show="{{ visible }}">
      <div class="modal-panel">
        <div class="modal-header">
          <text class="modal-title">添加供应商</text>
          <div class="btn-close" @click="closePanel">
            <text class="close-text">✕</text>
          </div>
        </div>

        <text class="modal-hint">勾选需要使用的供应商并填入 API KEY</text>

        <list class="provider-list">
          <list-item for="tpl in filteredList" class="provider-item" type="default">
            <div class="item-row">
              <div class="checkbox" @click="toggleCheck(tpl.id)">
                <text class="check-mark" show="{{ isChecked(tpl.id) }}">✓</text>
              </div>
              <text class="item-name">{{ tpl.name }}</text>
            </div>
            <div class="key-area" show="{{ isChecked(tpl.id) }}">
              <input class="key-input" placeholder="API KEY"
                     value="{{ getKey(tpl.id) }}"
                     onchange="onKeyChange"></input>
              <input class="key-input" placeholder="API Secret"
                     show="{{ tpl.authType === 'hmac' }}"
                     value="{{ getSecret(tpl.id) }}"
                     onchange="onSecretChange"></input>
            </div>
          </list-item>
        </list>

        <div class="modal-footer">
          <div class="btn-cancel" @click="closePanel">
            <text class="btn-text-cancel">取消</text>
          </div>
          <div class="btn-confirm" @click="confirmAdd">
            <text class="btn-text-confirm">确认添加</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import prompt from '@system.prompt'

export default {
  props: ['visible', 'templates', 'existingIds'],

  data: function () {
    return {
      selected: {},
      keyMap: {},
      secretMap: {},
      editingId: ''
    }
  },

  computed: {
    filteredList: function () {
      var templates = this.templates || []
      var existing = this.existingIds || []
      var result = []
      for (var i = 0; i < templates.length; i++) {
        if (existing.indexOf(templates[i].id) === -1) {
          result.push(templates[i])
        }
      }
      return result
    }
  },

  onShow: function () {
    this.selected = {}
    this.keyMap = {}
    this.secretMap = {}
  },

  isChecked: function (id) {
    return !!this.selected[id]
  },

  getKey: function (id) {
    return this.keyMap[id] || ''
  },

  getSecret: function (id) {
    return this.secretMap[id] || ''
  },

  toggleCheck: function (id) {
    this.selected[id] = !this.selected[id]
  },

  onKeyChange: function (e) {
    if (this.editingId) {
      this.keyMap[this.editingId] = e.text || ''
    }
  },

  onSecretChange: function (e) {
    if (this.editingId) {
      this.secretMap[this.editingId] = e.text || ''
    }
  },

  closePanel: function () {
    this.$dispatch('closeAddPanel')
  },

  confirmAdd: function () {
    var self = this
    var ids = Object.keys(this.selected).filter(function (id) { return self.selected[id] })
    if (ids.length === 0) {
      prompt.showToast({ message: '请至少选择一个供应商' })
      return
    }

    var missingKey = ids.find(function (id) {
      return !self.keyMap[id] || !self.keyMap[id].trim()
    })
    if (missingKey) {
      prompt.showToast({ message: '请填写已选供应商的 API KEY' })
      return
    }

    this.$dispatch('addConfirm', {
      selectedIds: ids,
      keyMap: this.keyMap,
      secretMap: this.secretMap
    })
  }
}
</script>

<style>
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  align-items: center;
  justify-content: center;
}
.modal-panel {
  width: 88%;
  max-height: 80%;
  background-color: #fff;
  border-radius: 8px;
  flex-direction: column;
}
.modal-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #eee;
}
.modal-title { font-size: 17px; font-weight: bold; color: #1a1a1a; }
.btn-close { width: 28px; height: 28px; align-items: center; justify-content: center; }
.close-text { font-size: 18px; color: #999; }
.modal-hint { font-size: 12px; color: #aaa; padding: 8px 16px; }

.provider-list { flex: 1; padding: 0 16px; }
.provider-item { margin-bottom: 10px; flex-direction: column; }
.item-row { flex-direction: row; align-items: center; padding: 6px 0; }
.checkbox {
  width: 22px; height: 22px;
  border: 1px solid #ccc; border-radius: 3px;
  align-items: center; justify-content: center; margin-right: 8px;
}
.check-mark { font-size: 14px; color: #4a90d9; }
.item-name { font-size: 14px; color: #333; }
.key-area { margin-left: 30px; margin-top: 6px; flex-direction: column; }
.key-input {
  height: 36px; border: 1px solid #ddd; border-radius: 3px;
  padding: 0 8px; margin-bottom: 6px; font-size: 12px;
}

.modal-footer {
  flex-direction: row; justify-content: flex-end;
  padding: 12px 16px; border-top: 1px solid #eee;
}
.btn-cancel { padding: 8px 16px; background-color: #eee; border-radius: 4px; margin-right: 8px; }
.btn-confirm { padding: 8px 20px; background-color: #4a90d9; border-radius: 4px; }
.btn-text-cancel { font-size: 14px; color: #666; }
.btn-text-confirm { font-size: 14px; color: #fff; }
</style>
