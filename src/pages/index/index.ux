<template>
  <div class="app">
    <!-- ====== 顶栏 ====== -->
    <div class="topbar">
      <text class="title">API 用量</text>
      <div class="topbar-actions">
        <div class="btn-icon" @click="doRefreshAll">
          <image class="icon" src="/assets/refresh.svg"></image>
        </div>
        <div class="btn-icon" @click="openImport">
          <text class="btn-label">📋</text>
        </div>
      </div>
    </div>

    <!-- ====== 副栏 ====== -->
    <div class="subbar">
      <text class="count-text">已配置: {{ activeCount }} 家</text>
      <div class="btn-add" @click="openAdd">
        <text class="btn-add-text">+ 添加</text>
      </div>
    </div>

    <!-- ====== 刷新中 ====== -->
    <div class="refresh-bar" show="{{ refreshing }}">
      <text class="refresh-text">正在刷新...</text>
    </div>

    <!-- ====== 空状态 ====== -->
    <div class="empty-state" show="{{ activeCount === 0 }}">
      <text class="empty-icon">📊</text>
      <text class="empty-title">还没有配置供应商</text>
      <text class="empty-hint">点击「+ 添加」选择供应商并填入 API KEY</text>
      <text class="empty-hint">或「📋」导入 JSON 配置</text>
    </div>

    <!-- ====== 卡片区域 ====== -->
    <div class="card-area" show="{{ activeCount > 0 }}">
      <div class="provider-card" for="card in cards">
        <div class="card-header" @click="toggleCard(card.id)">
          <div class="card-left">
            <text class="card-name">{{ card.name }}</text>
            <text class="card-status status-{{ card.status }}">{{ card.statusLabel }}</text>
          </div>
          <text class="card-balance">{{ card.balanceText }}</text>
        </div>
        <div class="card-detail" show="{{ card.expanded }}">
          <!-- 智谱 Coding Plan 用量（与 web 版一致） -->
          <div class="detail-row" show="{{ card.cp5Show }}">
            <text class="detail-label">Coding Plan 5小时:</text>
            <text class="detail-value {{ card.cp5Cls }}">{{ card.cp5Text }}</text>
          </div>
          <div class="detail-row" show="{{ card.cp7Show }}">
            <text class="detail-label">Coding Plan 7天:</text>
            <text class="detail-value {{ card.cp7Cls }}">{{ card.cp7Text }}</text>
          </div>
          <!-- 商汤各模型 5 小时窗口余量（与 web 版 sensenovaModels 一致） -->
          <div class="detail-row" for="m in card.sensenovaModels">
            <text class="detail-label">{{ m.name }}:</text>
            <text class="detail-value {{ m.cls }}">{{ m.pct }}%</text>
          </div>
          <div class="detail-row" for="row in card.extraRows">
            <text class="detail-label">{{ row.label }}</text>
            <text class="detail-value">{{ row.value }}</text>
          </div>
          <div class="card-actions">
            <div class="action-btn" @click="refreshOne(card.id)"><text class="action-text">刷新</text></div>
            <div class="action-btn" @click="editOne(card.id)"><text class="action-text">编辑</text></div>
            <div class="action-btn action-del" @click="deleteOne(card.id)"><text class="action-text">删除</text></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ====== 弹窗：添加供应商 ====== -->
    <div class="modal-mask" show="{{ showAddPanel }}">
      <div class="modal-panel add-panel">
        <div class="modal-header">
          <text class="modal-title">添加供应商</text>
          <div class="btn-close" @click="showAddPanel = false"><text class="close-text">✕</text></div>
        </div>
        <text class="hint">勾选并填入 API KEY</text>
        <div class="add-scroll">
          <div class="add-item" for="tpl in availableTemplates">
            <div class="add-item-row">
              <div class="checkbox" @click="checkTpl(tpl.id)">
                <text class="check-mark" show="{{ tpl.checked }}">✓</text>
              </div>
              <text class="add-item-name">{{ tpl.name }}</text>
            </div>
            <div class="add-key-area" show="{{ tpl.checked }}">
              <input class="add-input" placeholder="名称（可选）" value="{{ tpl.customName }}" onchange="onAddNameChange"></input>
              <input class="add-input" placeholder="API 地址" value="{{ tpl.endpoint }}" onchange="onAddEndpointChange"></input>
              <input class="add-input" placeholder="API KEY / PIN" value="{{ tpl.key }}" onchange="onAddKeyChange"></input>
              <input class="add-input" placeholder="账户（手机号）" show="{{ tpl.isSensenova }}" value="{{ tpl.account }}" onchange="onAddAccountChange"></input>
              <input class="add-input" placeholder="API Secret"
                     show="{{ tpl.isHmac }}" value="{{ tpl.secret }}" onchange="onAddSecretChange"></input>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <div class="btn-cancel" @click="showAddPanel = false"><text class="btn-text-cancel">取消</text></div>
          <div class="btn-confirm" @click="confirmAdd"><text class="btn-text-confirm">确认添加</text></div>
        </div>
      </div>
    </div>

    <!-- ====== 弹窗：批量导入 JSON ====== -->
    <div class="modal-mask" show="{{ showImportPanel }}">
      <div class="modal-panel import-panel">
        <div class="modal-header">
          <text class="modal-title">批量导入配置</text>
          <div class="btn-close" @click="showImportPanel = false"><text class="close-text">✕</text></div>
        </div>
        <text class="hint">修改 apiKey 后粘贴完整的 JSON</text>
        <div class="btn-tmpl" @click="loadTemplate"><text class="btn-tmpl-text">📋 加载预置模板</text></div>
        <textarea class="import-textarea" onchange="onImportTextChange">{{ importText }}</textarea>
        <text class="error-text" show="{{ importError }}">{{ importError }}</text>
        <div class="modal-footer">
          <div class="btn-cancel" @click="showImportPanel = false"><text class="btn-text-cancel">取消</text></div>
          <div class="btn-confirm" @click="confirmImport"><text class="btn-text-confirm">导入</text></div>
        </div>
      </div>
    </div>

    <!-- ====== 弹窗：编辑 KEY ====== -->
    <div class="modal-mask" show="{{ showEditPanel }}">
      <div class="modal-content">
        <text class="modal-title">编辑 {{ editName }}</text>
        <input class="modal-input" placeholder="名称" value="{{ editName }}" onchange="onEditNameChg"></input>
        <input class="modal-input" placeholder="API 地址" value="{{ editEndpoint }}" onchange="onEditEndpointChg" show="{{ !editHideEndpoint }}"></input>
        <input class="modal-input" placeholder="API KEY" value="{{ editKey }}" onchange="onEditKeyChg"></input>
        <input class="modal-input" placeholder="账户（手机号）" value="{{ editAccount }}" onchange="onEditAccountChg" show="{{ editShowAccount }}"></input>
        <input class="modal-input" placeholder="API Secret（仅讯飞需要）" show="{{ editHasSecret }}"
               value="{{ editSecret }}" onchange="onEditSecretChg"></input>
        <div class="modal-footer">
          <div class="btn-cancel" @click="showEditPanel = false"><text class="btn-text-cancel">取消</text></div>
          <div class="btn-confirm" @click="saveEdit"><text class="btn-text-confirm">保存</text></div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { PROVIDER_TEMPLATES, generateImportTemplate } from '../../common/providers.js'
import { queryAllBalances, queryBalance, fetchZhipuCodingPlan, fetchSenseNovaUsage } from '../../common/api.js'
import { parseResponse, formatForDisplay, parseZhipuCpData, parseSenseNovaData } from '../../common/parser.js'
import { loadProviders, saveProviders, loadSnapshot, saveSnapshot } from '../../common/storage.js'
import prompt from '@system.prompt'

var STATUS_MAP = { ok: '正常', low: '不足', exhausted: '已耗尽', unknown: '未知', error: '错误' }

var LABEL_MAP = {
  voucher: '代金券', cash: '现金', credit: '授信', chargeBalance: '充值余额',
  availableBalance: '可用余额', recharge: '充值', gift: '赠送', owed: '欠费',
  type: '类型', used: '已用', total: '总额', name: '用户', currency: '货币'
}

export default {
  data: {
    // 核心
    providers: [],
    cards: [],
    refreshing: false,

    // 添加弹窗
    showAddPanel: false,
    availableTemplates: [],
    addKeyMap: {},
    addSecretMap: {},
    addChecked: {},

    // 导入弹窗
    showImportPanel: false,
    importText: '',
    importError: '',

    // 编辑弹窗
    showEditPanel: false,
    editId: '',
    editName: '',
    editEndpoint: '',
    editKey: '',
    editSecret: '',
    editAccount: '',
    editHasSecret: false,
    editHideEndpoint: false,
    editShowAccount: false,

    // 编辑输入缓冲
    _chgKey: '',
    _chgSecret: ''
  },

  computed: {
    activeCount: function () {
      var n = 0
      for (var i = 0; i < this.providers.length; i++) {
        if (this.providers[i].apiKey && this.providers[i].apiKey.trim()) n++
      }
      return n
    }
  },

  // ============ 生命周期 ============

  onInit: function () {
    var self = this
    loadProviders().then(function (saved) {
      if (saved && saved.length) {
        self.providers = saved
      }
      // 旧数据迁移：无 uid/tid → uid=id, tid=id, account=''
      for (var i = 0; i < self.providers.length; i++) {
        var p = self.providers[i]
        if (!p.uid) { p.uid = p.id || ('p_' + Date.now() + '_' + i); p.tid = p.id || p.uid }
        else if (!p.tid) p.tid = p.id || p.uid
        if (p.account === undefined) p.account = ''
        p.id = p.uid
      }
      return loadSnapshot()
    }).then(function (snap) {
      if (snap && snap.results && snap.results.length) {
        self._renderCards(snap.results)
      } else if (self.activeCount > 0) {
        // 首次无快照时自动刷新兜底；有快照则显示上次数据与其真实更新时间，由用户手动刷新
        self.doRefreshAll()
      }
    })
  },

  // ============ 刷新 ============

  doRefreshAll: function () {
    var self = this
    var active = this._getActive()
    if (!active.length) return

    this.refreshing = true
    queryAllBalances(this.providers).then(function (results) {
      var display = []
      var handled = {}
      for (var i = 0; i < results.length; i++) {
        var r = results[i]
        handled[r.providerId] = true
        var rProv = self._findProv(r.providerId)
        if (r.status === 'ok') {
          display.push(self._buildCard(r.providerId, r.data))
        } else {
          display.push({
            id: r.providerId,
            uid: r.providerId,
            tid: rProv ? rProv.tid : '',
            name: self._provName(r.providerId),
            status: 'error',
            statusLabel: '错误',
            balanceText: r.message || '失败',
            expanded: false,
            extraRows: [],
            codingPlan: null,
            sensenovaModels: [],
            lastUpdate: Date.now()
          })
        }
      }
      for (var j = 0; j < active.length; j++) {
        if (!handled[active[j].id]) {
          display.push({
            id: active[j].id,
            uid: active[j].id,
            tid: active[j].tid,
            name: active[j].name,
            status: 'unknown',
            statusLabel: '未知',
            balanceText: '—',
            expanded: false,
            extraRows: [],
            codingPlan: null,
            sensenovaModels: [],
            lastUpdate: 0
          })
        }
      }
      // 为智谱并行查询 Coding Plan、商汤并行查询各模型余量（与 web 版 refreshAll 一致）
      var cpPromises = []
      for (var n = 0; n < display.length; n++) {
        if (display[n].tid === 'zhipu') {
          cpPromises.push(self._queryZhipuCodingPlan(display[n]))
        }
        if (display[n].tid === 'sensenova') {
          cpPromises.push(self._querySenseNovaUsage(display[n]))
        }
      }
      var finish = function () {
        self._renderCards(display)
        saveSnapshot(display)
        self.refreshing = false
      }
      if (cpPromises.length) {
        Promise.all(cpPromises).then(finish, finish)
      } else {
        finish()
      }
    }).catch(function () {
      self.refreshing = false
    })
  },

  refreshOne: function (id) {
    var self = this
    var prov = this._findProv(id)
    if (!prov) return
    queryBalance(prov).then(function (res) {
      var card = self._buildCard(prov.uid, res.data)
      for (var i = 0; i < self.cards.length; i++) {
        if (self.cards[i].uid === id || self.cards[i].id === id) {
          self.cards.splice(i, 1, card)
          break
        }
      }
      saveSnapshot(self.cards)
      // 智谱额外查询 Coding Plan、商汤额外查询各模型余量（与 web 版 refreshOne 一致）
      if (prov.tid === 'zhipu') {
        self._queryZhipuCodingPlan(card).then(function () {
          self.cards = self.cards.slice()
          saveSnapshot(self.cards)
        })
      }
      if (prov.tid === 'sensenova') {
        self._querySenseNovaUsage(card).then(function () {
          self.cards = self.cards.slice()
          saveSnapshot(self.cards)
        })
      }
    }).catch(function (e) {
      prompt.showToast({ message: '刷新失败: ' + ((e && e.message) || '请求出错') })
    })
  },

  // ============ 卡片操作 ============

  toggleCard: function (id) {
    for (var i = 0; i < this.cards.length; i++) {
      if (this.cards[i].id === id) {
        this.cards[i].expanded = !this.cards[i].expanded
        break
      }
    }
  },

  editOne: function (id) {
    var prov = this._findProv(id)
    if (!prov) return
    this.editId = id
    this.editName = prov.name
    this.editEndpoint = prov.endpoint || ''
    this.editKey = prov.apiKey || ''
    this.editSecret = prov.apiSecret || ''
    this.editAccount = prov.account || ''
    this.editHasSecret = prov.authType === 'hmac'
    this.editHideEndpoint = (prov.tid === 'sensenova')
    this.editShowAccount = (prov.tid === 'sensenova')
    this.showEditPanel = true
  },

  deleteOne: function (id) {
    var self = this
    // 删除前确认（与 web 版 confirm 一致）
    prompt.showDialog({
      message: '确定移除该供应商？',
      buttons: [
        { text: '取消', color: '#666666' },
        { text: '确定', color: '#e53935' }
      ]
    }).then(function (res) {
      if (res && res.index === 1) self._doDelete(id)
    }).catch(function () {})
  },

  _doDelete: function (id) {
    // 删除该 provider 实例（多实例：按 uid 删）
    var provs = []
    for (var p = 0; p < this.providers.length; p++) {
      if (this.providers[p].uid !== id) provs.push(this.providers[p])
    }
    this.providers = provs
    saveProviders(this.providers)
    var cards = []
    for (var i = 0; i < this.cards.length; i++) {
      if (this.cards[i].uid !== id && this.cards[i].id !== id) cards.push(this.cards[i])
    }
    this.cards = cards
    saveSnapshot(this.cards)
  },

  // ============ 添加供应商 ============

  openAdd: function () {
    var list = []
    for (var i = 0; i < PROVIDER_TEMPLATES.length; i++) {
      var tpl = PROVIDER_TEMPLATES[i]
      list.push({
        id: tpl.id,
        name: tpl.name,
        isHmac: tpl.authType === 'hmac',
        isSensenova: tpl.id === 'sensenova',
        checked: false,
        key: '',
        secret: '',
        customName: '',
        endpoint: tpl.endpoint,
        account: ''
      })
    }
    this.availableTemplates = list
    this.showAddPanel = true
  },

  checkTpl: function (id) {
    for (var i = 0; i < this.availableTemplates.length; i++) {
      if (this.availableTemplates[i].id === id) {
        this.availableTemplates[i].checked = !this.availableTemplates[i].checked
        break
      }
    }
  },

  onAddKeyChange: function (e) {
    // Quick App input onchange gives e.text
    // We use a simple data binding approach
  },

  onAddNameChange: function (e) {
  },

  onAddEndpointChange: function (e) {
  },

  onAddAccountChange: function (e) {
  },

  onAddSecretChange: function (e) {
  },

  confirmAdd: function () {
    var self = this
    var toAdd = []
    for (var i = 0; i < this.availableTemplates.length; i++) {
      var t = this.availableTemplates[i]
      if (t.checked) {
        if (!t.key || !t.key.trim()) {
          prompt.showToast({ message: '请填写 ' + t.name + ' 的 KEY/PIN' })
          return
        }
        toAdd.push(t)
      }
    }
    if (!toAdd.length) {
      prompt.showToast({ message: '请至少选择一个供应商' })
      return
    }

    for (var j = 0; j < toAdd.length; j++) {
      var tpl = null
      for (var k = 0; k < PROVIDER_TEMPLATES.length; k++) {
        if (PROVIDER_TEMPLATES[k].id === toAdd[j].id) { tpl = PROVIDER_TEMPLATES[k]; break }
      }
      if (!tpl) continue
      var copy = JSON.parse(JSON.stringify(tpl))
      copy.uid = 'p_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8)
      copy.tid = toAdd[j].id
      copy.name = (toAdd[j].customName && toAdd[j].customName.trim()) || tpl.name
      copy.endpoint = (toAdd[j].endpoint && toAdd[j].endpoint.trim()) || tpl.endpoint
      copy.apiKey = toAdd[j].key
      copy.account = toAdd[j].account || ''
      copy.apiSecret = toAdd[j].secret || ''
      copy.id = copy.uid
      this.providers.push(copy)
    }

    saveProviders(this.providers)
    this.showAddPanel = false
    this.doRefreshAll()
  },

  // ============ 导入 JSON ============

  openImport: function () {
    this.importText = generateImportTemplate()
    this.importError = ''
    this.showImportPanel = true
  },

  loadTemplate: function () {
    this.importText = generateImportTemplate()
    this.importError = ''
  },

  onImportTextChange: function (e) {
    this.importText = e.text || ''
  },

  confirmImport: function () {
    if (!this.importText || !this.importText.trim()) {
      this.importError = '请输入 JSON 配置'
      return
    }
    try {
      var data = JSON.parse(this.importText)
      if (!data.providers || !(data.providers instanceof Array)) {
        this.importError = '格式错误：需要 providers 数组'
        return
      }
      for (var i = 0; i < data.providers.length; i++) {
        var imp = data.providers[i]
        var valid = false
        for (var k = 0; k < PROVIDER_TEMPLATES.length; k++) {
          if (PROVIDER_TEMPLATES[k].id === imp.id) { valid = true; break }
        }
        if (!valid) { this.importError = '未知供应商: ' + imp.id; return }

        var tpl = null
        for (var m = 0; m < PROVIDER_TEMPLATES.length; m++) {
          if (PROVIDER_TEMPLATES[m].id === imp.id) { tpl = PROVIDER_TEMPLATES[m]; break }
        }
        if (tpl) {
          var copy = JSON.parse(JSON.stringify(tpl))
          copy.uid = imp.uid || ('p_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8))
          copy.tid = imp.id
          copy.name = imp.name || tpl.name
          copy.endpoint = imp.endpoint || tpl.endpoint
          copy.apiKey = imp.apiKey || ''
          copy.account = imp.account || ''
          copy.apiSecret = imp.apiSecret || ''
          copy.id = copy.uid
          this.providers.push(copy)
        }
      }
      saveProviders(this.providers)
      this.showImportPanel = false
      this.doRefreshAll()
    } catch (e) {
      this.importError = 'JSON 格式错误: ' + e.message
    }
  },

  // ============ 编辑弹窗 ============

  onEditNameChg: function (e) {
    this.editName = e.text || ''
  },

  onEditEndpointChg: function (e) {
    this.editEndpoint = e.text || ''
  },

  onEditKeyChg: function (e) {
    this.editKey = e.text || ''
  },

  onEditSecretChg: function (e) {
    this.editSecret = e.text || ''
  },

  onEditAccountChg: function (e) {
    this.editAccount = e.text || ''
  },

  saveEdit: function () {
    var prov = this._findProv(this.editId)
    if (prov) {
      prov.name = this.editName.trim() || prov.name
      prov.endpoint = this.editEndpoint.trim() || prov.endpoint
      prov.apiKey = this.editKey.trim()
      prov.apiSecret = this.editSecret ? this.editSecret.trim() : ''
      prov.account = this.editAccount.trim()
      saveProviders(this.providers)
    }
    this.showEditPanel = false
    this.doRefreshAll()
  },

  // ============ 内部辅助 ============

  _getActive: function () {
    var arr = []
    for (var i = 0; i < this.providers.length; i++) {
      if (this.providers[i].apiKey && this.providers[i].apiKey.trim()) arr.push(this.providers[i])
    }
    return arr
  },

  _findProv: function (id) {
    for (var i = 0; i < this.providers.length; i++) {
      if (this.providers[i].id === id) return this.providers[i]
    }
    return null
  },

  _provName: function (id) {
    var p = this._findProv(id)
    return p ? p.name : id
  },

  _buildCard: function (id, rawData) {
    var prov = this._findProv(id)
    if (!prov) return { id: id, uid: id, name: id, status: 'unknown', statusLabel: '未知', balanceText: '—', expanded: false, extraRows: [], codingPlan: null, sensenovaModels: [], lastUpdate: 0 }
    var parsed = parseResponse(rawData, prov.responseMapping)
    var fmt = formatForDisplay(parsed)
    var rows = []
    var extra = fmt.extra || {}
    var keys = Object.keys(extra)
    for (var i = 0; i < keys.length; i++) {
      var key = keys[i]
      var val = extra[key]
      if (val !== null && val !== undefined) {
        rows.push({ label: LABEL_MAP[key] || key, value: String(val) })
      }
    }
    // 保留已有的 codingPlan / sensenovaModels 数据（避免余额查询结果覆盖附加数据，与 web 版 buildCard 一致）
    var existingCp = null
    var existingSn = null
    for (var n = 0; n < this.cards.length; n++) {
      if (this.cards[n].uid === id || this.cards[n].id === id) {
        existingCp = this.cards[n].codingPlan
        existingSn = this.cards[n].sensenovaModels
        break
      }
    }
    var card = {
      id: id,
      uid: id,
      tid: prov.tid,
      name: prov.name,
      status: fmt.status,
      statusLabel: STATUS_MAP[fmt.status] || '未知',
      balanceText: fmt.balanceDisplay,
      expanded: false,
      extraRows: rows,
      codingPlan: existingCp,
      sensenovaModels: existingSn || [],
      lastUpdate: Date.now()
    }
    this._applyCodingPlanFields(card)
    return card
  },

  // ============ 智谱 Coding Plan ============

  _queryZhipuCodingPlan: function (card) {
    var self = this
    var p = this._findProv(card.uid || card.id)
    if (!p) return Promise.resolve()
    return fetchZhipuCodingPlan(p.apiKey).then(function (data) {
      card.codingPlan = parseZhipuCpData(data)
      self._applyCodingPlanFields(card)
    }).catch(function () {
      // Coding Plan 查询失败不影响余额显示（与 web 版一致）
      card.codingPlan = null
      self._applyCodingPlanFields(card)
    })
  },

  // ============ 商汤 SenseNova 各模型余量（与 web 版 querySenseNovaUsage 一致，仅手动 token 模式） ============

  _querySenseNovaUsage: function (card) {
    var p = this._findProv(card.uid || card.id)
    if (!p) return Promise.resolve()
    return fetchSenseNovaUsage(p.account, p.apiKey).then(function (result) {
      var models = parseSenseNovaData(result.usages, result.models)
      card.sensenovaModels = models.map(function (m) {
        return { name: m.name, pct: m.pct, cls: m.pct <= 0 ? 'cp-high' : m.pct <= 20 ? 'cp-warn' : 'cp-ok' }
      })
      if (card.sensenovaModels.length) {
        var minPct = Math.min.apply(null, models.map(function (m) { return m.pct }))
        card.balanceText = card.sensenovaModels.length + ' 个模型·最低 ' + minPct + '%'
        card.status = minPct < 20 ? 'low' : 'ok'
        card.statusLabel = STATUS_MAP[card.status] || '未知'
      }
    }).catch(function (e) {
      card.sensenovaModels = []
      card.status = 'error'
      card.statusLabel = STATUS_MAP['error'] || '错误'
      card.balanceText = (e && e.message) || '查询失败'
    })
  },

  // 根据 codingPlan 计算卡片展示字段（5h/7d 用量百分比及颜色档位）
  _applyCodingPlanFields: function (card) {
    card.cp5Show = false
    card.cp5Text = ''
    card.cp5Cls = ''
    card.cp7Show = false
    card.cp7Text = ''
    card.cp7Cls = ''
    var cp = card.codingPlan
    if (!cp) return
    if (cp.fiveHour) {
      card.cp5Show = true
      card.cp5Text = Math.round(cp.fiveHour.pct) + '%'
      card.cp5Cls = cp.fiveHour.pct <= 50 ? 'cp-ok' : (cp.fiveHour.pct <= 80 ? 'cp-warn' : 'cp-high')
    }
    if (cp.weekly) {
      card.cp7Show = true
      card.cp7Text = Math.round(cp.weekly.pct) + '%'
      card.cp7Cls = cp.weekly.pct <= 50 ? 'cp-ok' : (cp.weekly.pct <= 80 ? 'cp-warn' : 'cp-high')
    }
  },

  _renderCards: function (cards) {
    for (var i = 0; i < cards.length; i++) {
      if (!cards[i].statusLabel) {
        cards[i].statusLabel = STATUS_MAP[cards[i].status] || '未知'
      }
      if (!cards[i].extraRows) cards[i].extraRows = []
      this._applyCodingPlanFields(cards[i])
    }
    this.cards = cards
  }
}
</script>

<style>
.app { flex-direction: column; background-color: #f5f5f5; height: 100%; }

/* 顶栏 */
.topbar {
  flex-direction: row; align-items: center; justify-content: space-between;
  padding: 14px 16px; background-color: #fff; border-bottom: 1px solid #e0e0e0;
}
.title { font-size: 24px; font-weight: bold; color: #1a1a1a; }
.topbar-actions { flex-direction: row; }
.btn-icon { width: 40px; height: 40px; align-items: center; justify-content: center; margin-left: 8px; }
.btn-label { font-size: 24px; }
.icon { width: 26px; height: 26px; }

/* 副栏 */
.subbar {
  flex-direction: row; align-items: center; justify-content: space-between;
  padding: 10px 16px; background-color: #fafafa; border-bottom: 1px solid #eee;
}
.count-text { font-size: 16px; color: #888; }
.btn-add { padding: 6px 16px; background-color: #4a90d9; border-radius: 4px; }
.btn-add-text { font-size: 16px; color: #fff; }

.refresh-bar { flex-direction: row; justify-content: center; padding: 10px; }
.refresh-text { font-size: 15px; color: #999; }

/* 空状态 */
.empty-state { flex-direction: column; align-items: center; justify-content: center; flex: 1; }
.empty-icon { font-size: 56px; margin-bottom: 14px; }
.empty-title { font-size: 20px; color: #666; margin-bottom: 8px; }
.empty-hint { font-size: 16px; color: #aaa; margin-top: 4px; }

/* 卡片 */
.card-area { flex: 1; padding: 10px 14px; }
.provider-card {
  background-color: #fff; border-radius: 8px; padding: 14px 16px;
  margin-bottom: 8px; border-left-width: 4px; border-left-color: #4a90d9;
}
.card-header { flex-direction: row; justify-content: space-between; align-items: center; }
.card-left { flex-direction: column; }
.card-name { font-size: 18px; font-weight: bold; color: #1a1a1a; }
.card-status { font-size: 14px; margin-top: 3px; }
.card-balance { font-size: 20px; font-weight: bold; color: #1a1a1a; }
.status-ok { color: #4caf50; }
.status-low { color: #ff9800; }
.status-exhausted { color: #f44336; }
.status-unknown { color: #999; }
.status-error { color: #f44336; }

.card-detail { margin-top: 10px; border-top: 1px solid #f0f0f0; padding-top: 10px; flex-direction: column; }
.detail-row { flex-direction: row; justify-content: space-between; padding: 5px 0; }
.detail-label { font-size: 15px; color: #888; }
.detail-value { font-size: 15px; color: #333; }
/* Coding Plan 用量颜色档位（与 web 版 cp-item 一致） */
.cp-ok { color: #4caf50; }
.cp-warn { color: #ff9800; }
.cp-high { color: #f44336; }
.card-actions { flex-direction: row; margin-top: 10px; }
.action-btn { padding: 6px 14px; background-color: #f0f0f0; border-radius: 4px; margin-right: 8px; }
.action-del { background-color: #fce4ec; }
.action-text { font-size: 15px; color: #555; }
.action-del .action-text { color: #e53935; }

/* 弹窗通用 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center;
}
.modal-header {
  flex-direction: row; justify-content: space-between; align-items: center;
  padding: 16px 18px; border-bottom: 1px solid #eee;
}
.modal-title { font-size: 20px; font-weight: bold; color: #1a1a1a; }
.btn-close { padding: 4px; }
.close-text { font-size: 22px; color: #999; }
.hint { font-size: 15px; color: #aaa; padding: 10px 18px; }
.modal-footer { flex-direction: row; justify-content: flex-end; padding: 14px 18px; border-top: 1px solid #eee; }
.btn-cancel { padding: 10px 20px; background-color: #eee; border-radius: 4px; margin-right: 10px; }
.btn-confirm { padding: 10px 24px; background-color: #4a90d9; border-radius: 4px; }
.btn-text-cancel { font-size: 16px; color: #666; }
.btn-text-confirm { font-size: 16px; color: #fff; }

/* 添加弹窗 */
.add-panel { width: 88%; max-height: 80%; background-color: #fff; border-radius: 8px; flex-direction: column; }
.add-scroll { flex: 1; padding: 0 18px; }
.add-item { margin-bottom: 12px; flex-direction: column; }
.add-item-row { flex-direction: row; align-items: center; padding: 8px 0; }
.checkbox { width: 26px; height: 26px; border: 1px solid #ccc; border-radius: 3px; align-items: center; justify-content: center; margin-right: 10px; }
.check-mark { font-size: 16px; color: #4a90d9; }
.add-item-name { font-size: 17px; color: #333; }
.add-key-area { margin-left: 36px; margin-top: 8px; flex-direction: column; }
.add-input { height: 42px; border: 1px solid #ddd; border-radius: 4px; padding: 0 10px; margin-bottom: 8px; font-size: 15px; }

/* 导入弹窗 */
.import-panel { width: 92%; max-height: 90%; background-color: #fff; border-radius: 8px; flex-direction: column; }
.btn-tmpl { margin: 0 18px 10px; padding: 8px 14px; background-color: #e8f4fd; border-radius: 4px; align-self: flex-start; }
.btn-tmpl-text { font-size: 14px; color: #4a90d9; }
.import-textarea {
  flex: 1; margin: 0 18px 10px; border: 1px solid #ddd; border-radius: 4px;
  padding: 12px; font-size: 13px; background-color: #fafafa;
}
.error-text { font-size: 14px; color: #e53935; padding: 0 18px 10px; }

/* 编辑弹窗 */
.modal-content {
  width: 82%; background-color: #fff; border-radius: 8px; padding: 22px; flex-direction: column;
}
.modal-input { height: 44px; border: 1px solid #ddd; border-radius: 4px; padding: 0 12px; margin-bottom: 12px; font-size: 16px; }
</style>
